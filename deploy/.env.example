# Task 31: the values of deploy/compose.yaml. On the office server, copy this
# file to .env beside compose.yaml, fill in every line, and make it readable
# by its owner only:
#
#   cp .env.example .env && chmod 600 .env
#
# .env never leaves the server and is never committed (.gitignore). Every
# line is required: with one empty, docker compose refuses to start.
# docs/DEPLOYMENT.md explains each one.

# The image to run, as tagged when it was built (e.g. 1.0.0).
APP_VERSION=

# A folder on the encrypted data disk (Task 35a), e.g. /srv/insurance-office.
# The database lives in its postgresql/ subfolder.
DATA_DIR=

# The application's database and role (e.g. insurance_office and
# insurance_app). Only the first start creates them.
DB_NAME=
DB_USER=

# Random, 32 characters or more, made on the server, e.g.
#   openssl rand -base64 48 | tr -d '/+=\n' | cut -c1-40
# Its copy is kept as TASKS, Ε17 says.
DB_PASSWORD=

# The container's memory limit; the heap is 75% of it (e.g. 1g).
APP_MEMORY=
